          "name": "Reading List OpenAPI",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{readingListBaseUrl}}/openapi/v1.json"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Reading List OpenAPI\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const document = pm.response.json();",
                  "    pm.expect(document.openapi).to.be.a('string');",
                  "    pm.expect(document.paths).to.have.property('/titles');",
                  "    pm.expect(document.paths).to.have.property('/titles/{id}/finish');",
                  "});"
                ]
              }
            }
          ],
          "response": []
