{
  "info": {
    "name": "Reading App - Complete API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Single collection for both APIs. Start the Aspire AppHost with Docker Desktop running. Set readingListBaseUrl and readingSummaryBaseUrl to the API endpoints shown in the Aspire dashboard, without trailing slashes. Defaults match the HTTP launch profiles. No separate Postman environment is required. Use HTTPS URLs if HTTP redirects to HTTPS. Run folders in order or run the entire collection. The workflow compares counts with a baseline and works with existing data; avoid concurrent writes. Each full run creates two titles and leaves them finished because the API has no delete endpoint. OpenAPI requests require Development. Health assertions expect healthy dependencies. Postman sends HTTP requests; start/stop services and manage PostgreSQL through Aspire/Docker."
  },
  "variable": [
    {
      "key": "readingListBaseUrl",
      "value": "http://localhost:5095",
      "type": "string"
    },
    {
      "key": "readingSummaryBaseUrl",
      "value": "http://localhost:5066",
      "type": "string"
    },
    {
      "key": "titleText",
      "value": "Clean Code",
      "type": "string"
    },
    {
      "key": "titleId",
      "value": "",
      "type": "string"
    },
    {
      "key": "negativeTitleId",
      "value": "",
      "type": "string"
    },
    {
      "key": "baselineUnread",
      "value": "",
      "type": "string"
    },
    {
      "key": "baselineFinished",
      "value": "",
      "type": "string"
    }
  ],
