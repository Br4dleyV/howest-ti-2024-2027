    {
      "name": "02 - Reading workflow",
      "description": "Run in order: baseline, create, list, summarize, finish, list, summarize. Create automatically saves titleId. You can also send requests manually or set titleId to select an existing title. Summary delta assertions require the folder sequence and no concurrent writes.",
      "item": [
        {
          "name": "1. Get summary baseline",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{readingSummaryBaseUrl}}/summary"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset('titleId');",
                  "pm.collectionVariables.unset('baselineUnread');",
                  "pm.collectionVariables.unset('baselineFinished');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"1. Get summary baseline\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const summary = pm.response.json();",
                  "    pm.expect(summary.unread).to.be.a('number').and.to.be.at.least(0);",
                  "    pm.expect(summary.finished).to.be.a('number').and.to.be.at.least(0);",
                  "    pm.collectionVariables.set('baselineUnread', summary.unread);",
                  "    pm.collectionVariables.set('baselineFinished', summary.finished);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "2. Create title",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{readingListBaseUrl}}/titles",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"{{titleText}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset('titleId');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"2. Create title\", function () {",
                  "    pm.response.to.have.status(201);",
                  "    const title = pm.response.json();",
                  "    pm.expect(title.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);",
                  "    pm.expect(title.title).to.eql(pm.variables.get('titleText').trim());",
                  "    pm.expect(title.isRead).to.eql(false);",
                  "    pm.collectionVariables.set('titleId', title.id);",
                  "    pm.expect(pm.response.headers.get('Location')).to.eql('/titles/' + pm.collectionVariables.get('titleId'));",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "3. Get titles - verify unread",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{readingListBaseUrl}}/titles"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"3. Get titles - verify unread\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const titles = pm.response.json();",
                  "    pm.expect(titles).to.be.an('array');",
                  "    const title = titles.find(item => item.id === pm.collectionVariables.get('titleId'));",
                  "    pm.expect(title, 'Created title must exist').to.be.an('object');",
                  "    pm.expect(title.title).to.eql(pm.variables.get('titleText').trim());",
                  "    pm.expect(title.isRead).to.eql(false);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "4. Get summary - verify unread",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{readingSummaryBaseUrl}}/summary"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"4. Get summary - verify unread\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const summary = pm.response.json();",
                  "    pm.expect(summary.unread).to.be.a('number').and.to.be.at.least(0);",
                  "    pm.expect(summary.finished).to.be.a('number').and.to.be.at.least(0);",
                  "    pm.expect(pm.collectionVariables.get('baselineUnread')).not.to.eql('');",
                  "    pm.expect(pm.collectionVariables.get('baselineFinished')).not.to.eql('');",
                  "    pm.expect(summary.unread).to.eql(Number(pm.collectionVariables.get('baselineUnread')) + 1);",
                  "    pm.expect(summary.finished).to.eql(Number(pm.collectionVariables.get('baselineFinished')));",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "5. Finish title",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{readingListBaseUrl}}/titles/{{titleId}}/finish"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"5. Finish title\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const title = pm.response.json();",
                  "    pm.expect(title.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);",
                  "    pm.expect(title.title).to.eql(pm.variables.get('titleText').trim());",
                  "    pm.expect(title.isRead).to.eql(true);",
                  "    pm.expect(title.id).to.eql(pm.collectionVariables.get('titleId'));",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "6. Get titles - verify finished",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{readingListBaseUrl}}/titles"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"6. Get titles - verify finished\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const titles = pm.response.json();",
                  "    pm.expect(titles).to.be.an('array');",
                  "    const title = titles.find(item => item.id === pm.collectionVariables.get('titleId'));",
                  "    pm.expect(title, 'Created title must exist').to.be.an('object');",
                  "    pm.expect(title.title).to.eql(pm.variables.get('titleText').trim());",
                  "    pm.expect(title.isRead).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "7. Get summary - verify finished",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{readingSummaryBaseUrl}}/summary"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"7. Get summary - verify finished\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const summary = pm.response.json();",
                  "    pm.expect(summary.unread).to.be.a('number').and.to.be.at.least(0);",
                  "    pm.expect(summary.finished).to.be.a('number').and.to.be.at.least(0);",
                  "    pm.expect(pm.collectionVariables.get('baselineUnread')).not.to.eql('');",
                  "    pm.expect(pm.collectionVariables.get('baselineFinished')).not.to.eql('');",
                  "    pm.expect(summary.unread).to.eql(Number(pm.collectionVariables.get('baselineUnread')));",
                  "    pm.expect(summary.finished).to.eql(Number(pm.collectionVariables.get('baselineFinished')) + 1);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "03 - Validation and errors",
      "description": "Run in order. Includes independent setup for repeated finish, using negativeTitleId.",
      "item": [
        {
          "name": "1. Reject whitespace title",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{readingListBaseUrl}}/titles",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"   \"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"1. Reject whitespace title\", function () {",
                  "    pm.response.to.have.status(400);",
                  "    pm.expect(pm.response.json()).to.contain('Title cannot be empty.');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "2. Reject empty title",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{readingListBaseUrl}}/titles",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"2. Reject empty title\", function () {",
                  "    pm.response.to.have.status(400);",
                  "    pm.expect(pm.response.json()).to.contain('Title cannot be empty.');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "3. Finish missing title",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{readingListBaseUrl}}/titles/00000000-0000-0000-0000-000000000000/finish"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"3. Finish missing title\", function () {",
                  "    pm.response.to.have.status(404);",
                  "    pm.expect(pm.response.json()).to.eql('Title with the specified ID was not found.');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "4. Create title for repeated finish",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{readingListBaseUrl}}/titles",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"{{titleText}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset('negativeTitleId');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"4. Create title for repeated finish\", function () {",
                  "    pm.response.to.have.status(201);",
                  "    const title = pm.response.json();",
                  "    pm.expect(title.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);",
                  "    pm.expect(title.title).to.eql(pm.variables.get('titleText').trim());",
                  "    pm.expect(title.isRead).to.eql(false);",
                  "    pm.collectionVariables.set('negativeTitleId', title.id);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "5. Finish title once",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{readingListBaseUrl}}/titles/{{negativeTitleId}}/finish"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"5. Finish title once\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const title = pm.response.json();",
                  "    pm.expect(title.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);",
                  "    pm.expect(title.title).to.eql(pm.variables.get('titleText').trim());",
                  "    pm.expect(title.isRead).to.eql(true);",
                  "    pm.expect(title.id).to.eql(pm.collectionVariables.get('negativeTitleId'));",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "6. Reject repeated finish",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{readingListBaseUrl}}/titles/{{negativeTitleId}}/finish"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"6. Reject repeated finish\", function () {",
                  "    pm.response.to.have.status(400);",
