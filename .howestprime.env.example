# --- PostgreSQL (Movies DB) ---
POSTGRES_DB=movies
POSTGRES_USER=howestprime_movies
POSTGRES_PASSWORD=CHANGE_ME

# --- MongoDB (Ticketing DB) ---
MONGO_INITDB_ROOT_USERNAME=howestprime_ticketing
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME

# --- Movies Microservice (.NET) ---
Database__Provider=PostgreSQL
Database__ConnectionString=Host=howestprime-movies-db;Port=5432;Database=movies;Username=howestprime_movies;Password=CHANGE_ME;
Database__Username=howestprime_movies
Database__Password=CHANGE_ME
MessageBroker__Hostname=howestprime-broker
MessageBroker__Port=5672
MessageBroker__Username=guest
MessageBroker__Password=CHANGE_ME
MessageBroker__VirtualHost=/

# --- Ticketing Microservice (Deno) ---
PERSISTENCE_MONGO_DB_HOST=howestprime-ticketing-db
PERSISTENCE_MONGO_DB_PORT=27017
PERSISTENCE_MONGO_DB_PROTOCOL=mongodb
PERSISTENCE_MONGO_DB_NAME=ticketing
PERSISTENCE_MONGO_DB_OPTIONS="authSource=admin&replicaSet=rs0"
PERSISTENCE_MONGO_DB_USER=howestprime_ticketing
PERSISTENCE_MONGO_DB_PASS=CHANGE_ME
PERSISTENCE_MONGO_DB_DIRECT_CONNECTION=true
MESSAGING_LAVINMQ_ASYNCAPI_PATH=config/asyncapi.yaml
MESSAGING_LAVINMQ_HOSTNAME=howestprime-broker
MESSAGING_LAVINMQ_PORT=5672
MESSAGING_LAVINMQ_USER=guest
MESSAGING_LAVINMQ_PASS=CHANGE_ME
MESSAGING_LAVINMQ_VHOST=/

# --- Backoffice Client (Blazor Server) ---
MoviesApi__BaseUrl=http://howestprime-movies:8000
MoviesApi__TimeoutSeconds=30

# --- Client Web Application (Frontend) ---
VITE_APP_MOVIES_BASE_API_URL=https://movies-api.CHANGE_ME.com
VITE_APP_TICKETING_API_URL=https://ticketing-api.CHANGE_ME.com
MOVIES_API_BASE_URL=http://howestprime-movies:8000
