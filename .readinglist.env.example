# --- PostgreSQL (ReadingList DB) ---
POSTGRES_DB=reading-list-db
POSTGRES_USER=readinglist_user
POSTGRES_PASSWORD=CHANGE_ME

# --- Aspire Connection String & Service Discovery ---
ConnectionStrings__reading-list-db=Host=readinglist-db;Port=5432;Database=reading-list-db;Username=readinglist_user;Password=CHANGE_ME
services__reading-list-api__http__0=http://reading-list-api:8000
