{
    "compilerOptions": {
        "strict": true,
        "noErrorTruncation": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitReturns": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noUncheckedIndexedAccess": true
    },
    "lint": {
        "include": ["src/"],
        "rules": {
            "tags": ["recommended"],
            "include": ["ban-untagged-todo"],
            "exclude": []
        }
    },
    "fmt": {
        "useTabs": false,
        "lineWidth": 100,
        "indentWidth": 4,
        "semiColons": true,
        "singleQuote": true,
        "proseWrap": "preserve",
        "include": ["src/"]
    },
    "lock": false,
    "nodeModulesDir": "none",
    "tasks": {
        "run": "deno run -A --env-file=config/.env src/Main/Main.ts"
    },
    "imports": {
        "@std/assert": "jsr:@std/assert@^1.0.15",
        "@oak/oak": "jsr:@oak/oak@^17.1.6",
        "@std/encoding/base64": "jsr:@std/encoding@^1.0.5/base64",
        "@std/yaml": "jsr:@std/yaml@^1.0.5",
        "Hackathon.Assistant/": "./src/",
        "@std/dotenv": "jsr:@std/dotenv@0.225.5",
        "@domaincrafters/std": "jsr:@domaincrafters/std@^1.1.0",            
        "@domaincrafters/di": "jsr:@domaincrafters/di@^1.1.0",
        "zod": "npm:zod@^3.23.8",
        "@google/adk": "npm:@google/adk@0.2.4"
    }
}
